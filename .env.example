# --- Meta WhatsApp Cloud API (required) ---
WHATSAPP_TOKEN=            # permanent System User token (see README)
WHATSAPP_PHONE_NUMBER_ID=  # from Meta > WhatsApp > API Setup
WHATSAPP_VERIFY_TOKEN=     # any long random string; paste the same one in Meta's webhook form
META_APP_SECRET=           # optional but recommended: App > Settings > Basic > App secret

# --- Cafe (required) ---
OWNER_WHATSAPP_NUMBER=     # owner's WhatsApp, country code, no plus. e.g. 9180xxxxxxxx
BASE_URL=                  # public URL of this server, e.g. https://whatsapp-cafe-bot.onrender.com
UPI_VPA=                   # the cafe's real UPI ID, e.g. 80xxxxxxxx@ybl. Leave empty = cash only
UPI_NAME=Beeburg Cafe

# --- AI chat (optional: bot works without it) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# --- Admin ---
ADMIN_SECRET=              # long random string; opens /admin?key=... and /health?key=...
DATA_DIR=./data            # on Render, point this at a persistent disk to keep order history
PORT=3000
GRAPH_VERSION=v23.0
